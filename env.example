# AI API Configuration
# Copy this file to .env.local and fill in your values
AI_API_KEY=your-api-key-here
AI_API_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
AI_MODEL=mimo-v2-omni

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Degraded mode (optional)
# Set to "true" to allow the app to run without Supabase in non-production environments.
# In production, this should be "false" (or omitted) — Supabase is required.
ALLOW_UNAUTHENTICATED_DEMO=false
